  <skos:Concept rdf:about="https://thesaurus.mn.cenagis.edu.pl/entity/Q514">
    <skos:inScheme rdf:resource="https://thesaurus.mn.cenagis.edu.pl/entity/Q457"/>
    <skos:prefLabel xml:lang="en">barbotine</skos:prefLabel>
    <skos:definition xml:lang="en">decorative technique using piped or trailed fluid clay slip to create raised patterns</skos:definition>
  </skos:Concept>

  <skos:Concept rdf:about="https://thesaurus.mn.cenagis.edu.pl/entity/Q515">
    <skos:inScheme rdf:resource="https://thesaurus.mn.cenagis.edu.pl/entity/Q457"/>
    <skos:prefLabel xml:lang="en">clay splashing</skos:prefLabel>
    <skos:definition xml:lang="en">decorative effect achieved by intentionally splashing or mottling fluid clay onto the vessel</skos:definition>
  </skos:Concept>

  <skos:Concept rdf:about="https://thesaurus.mn.cenagis.edu.pl/entity/Q516">
